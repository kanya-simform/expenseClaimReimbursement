# Copy to .env (same directory as docker-compose.yml) and fill in before `docker compose up`.
# This is the ONLY setup step beyond that command (spec §6).

# Credentials for the Postgres container this stack creates for itself — pick your own
# values. Avoid a literal "@" in the password; it's used unescaped in DATABASE_URL below.
POSTGRES_USER=expense_app
POSTGRES_PASSWORD=
POSTGRES_DB=expense_claims

# Required. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Only needs changing if you won't be opening the app from the same machine running
# docker compose (e.g. a remote host) — this is baked into the frontend build, so changing
# it requires `docker compose build frontend` again, not just a restart.
VITE_API_URL=http://localhost:4000/api
